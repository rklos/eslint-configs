{
  "name": "@rklos/eslint-config",
  "version": "3.1.5",
  "description": "Shared ESLint flat configs for JavaScript, TypeScript, React, Next.js, Vue, Svelte, Astro, Jest, Vitest, Cypress, and NestJS",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "flat-config",
    "javascript",
    "typescript",
    "react",
    "nextjs",
    "vue",
    "svelte",
    "astro",
    "jest",
    "vitest",
    "cypress",
    "nestjs",
    "airbnb",
    "linting",
    "code-quality"
  ],
  "homepage": "https://github.com/rklos/eslint-configs#readme",
  "bugs": {
    "url": "https://github.com/rklos/eslint-configs/issues"
  },
  "type": "module",
  "types": "./types.d.ts",
  "main": "./configs/base.mjs",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./configs/base.mjs"
    },
    "./base": {
      "types": "./types.d.ts",
      "default": "./configs/base.mjs"
    },
    "./typescript": {
      "types": "./types.d.ts",
      "default": "./configs/typescript.mjs"
    },
    "./cypress": {
      "types": "./types.d.ts",
      "default": "./configs/cypress.mjs"
    },
    "./jest": {
      "types": "./types.d.ts",
      "default": "./configs/jest.mjs"
    },
    "./nest": {
      "types": "./types.d.ts",
      "default": "./configs/nest.mjs"
    },
    "./next": {
      "types": "./types.d.ts",
      "default": "./configs/next.mjs"
    },
    "./next-ts": {
      "types": "./types.d.ts",
      "default": "./configs/next-ts.mjs"
    },
    "./react": {
      "types": "./types.d.ts",
      "default": "./configs/react.mjs"
    },
    "./react-ts": {
      "types": "./types.d.ts",
      "default": "./configs/react-ts.mjs"
    },
    "./vitest": {
      "types": "./types.d.ts",
      "default": "./configs/vitest.mjs"
    },
    "./vue": {
      "types": "./types.d.ts",
      "default": "./configs/vue.mjs"
    },
    "./vue-ts": {
      "types": "./types.d.ts",
      "default": "./configs/vue-ts.mjs"
    },
    "./svelte": {
      "types": "./types.d.ts",
      "default": "./configs/svelte.mjs"
    },
    "./svelte-ts": {
      "types": "./types.d.ts",
      "default": "./configs/svelte-ts.mjs"
    },
    "./astro": {
      "types": "./types.d.ts",
      "default": "./configs/astro.mjs"
    },
    "./astro-ts": {
      "types": "./types.d.ts",
      "default": "./configs/astro-ts.mjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "vitest run",
    "release": "yarn test && npm publish",
    "release:patch": "yarn version patch && yarn release",
    "release:minor": "yarn version minor && yarn release",
    "release:major": "yarn version major && yarn release"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rklos/eslint-configs.git"
  },
  "author": "rklos <radoslaw@klos.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "yarn@4.5.0",
  "files": [
    "configs",
    "utils",
    "types.d.ts"
  ],
  "dependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@stylistic/eslint-plugin-migrate": "^4.4.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-only-error": "^1.0.2",
    "eslint-plugin-only-warn": "^1.1.0",
    "globals": "^16.3.0"
  },
  "// devDepencencies": "It should contain all the peerDependencies",
  "devDependencies": {
    "@next/eslint-plugin-next": "^16",
    "@typescript-eslint/parser": "^8",
    "@vitest/eslint-plugin": "^1.6.9",
    "eslint": "^9 || ^10",
    "eslint-config-airbnb": "^19",
    "eslint-config-next": "^16",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-astro": "^1",
    "eslint-plugin-cypress": "^5",
    "eslint-plugin-jest": "^29",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5 || ^7",
    "eslint-plugin-svelte": "^3",
    "eslint-plugin-vue": "^10.8.0",
    "jest": "^30",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "svelte": "^5",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4",
    "vue": "^3",
    "vue-eslint-parser": "^10"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": "^15 || ^16",
    "@typescript-eslint/parser": "^8",
    "@vitest/eslint-plugin": "^1",
    "eslint": "^9 || ^10",
    "eslint-config-airbnb": "^19",
    "eslint-config-next": "^15 || ^16",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-astro": "^1",
    "eslint-plugin-cypress": "^5",
    "eslint-plugin-jest": "^29",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5 || ^7",
    "eslint-plugin-svelte": "^3",
    "eslint-plugin-vue": "^10",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vue-eslint-parser": "^10"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": { "optional": true },
    "@typescript-eslint/parser": { "optional": true },
    "@vitest/eslint-plugin": { "optional": true },
    "eslint-config-airbnb": { "optional": true },
    "eslint-config-next": { "optional": true },
    "eslint-import-resolver-typescript": { "optional": true },
    "eslint-plugin-astro": { "optional": true },
    "eslint-plugin-cypress": { "optional": true },
    "eslint-plugin-jest": { "optional": true },
    "eslint-plugin-jsx-a11y": { "optional": true },
    "eslint-plugin-react": { "optional": true },
    "eslint-plugin-react-hooks": { "optional": true },
    "eslint-plugin-svelte": { "optional": true },
    "eslint-plugin-vue": { "optional": true },
    "typescript": { "optional": true },
    "typescript-eslint": { "optional": true },
    "vue-eslint-parser": { "optional": true }
  }
}
